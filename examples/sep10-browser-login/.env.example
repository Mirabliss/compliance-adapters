# URL of the compliance-adapters example server (full-stack-demo or any server
# that exposes GET /auth and POST /auth as per SEP-10).
# During `npm run dev` the Vite dev server proxies /auth to this origin, so
# you don't normally need to change this.
VITE_SERVER_URL=http://localhost:3001

# Stellar network passphrase shown to the user in the Freighter signing dialog.
# The default matches the full-stack-demo server which uses testnet.
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
